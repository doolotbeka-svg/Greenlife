# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Finik online payments (finik.kg). Online payment appears at checkout once the API key, account ID
# and Finik public key are set and a signing key exists (see FINIK_PRIVATE_KEY).
# FINIK_API_KEY and FINIK_ACCOUNT_ID come from the Finik merchant account ("Keys" section).
FINIK_API_KEY=""
FINIK_ACCOUNT_ID=""
# Optional: your RSA private key (PEM; "\n" for line breaks). If empty, the server generates a key
# pair and keeps it in private storage; copy the public key for Finik from Admin > Settings.
FINIK_PRIVATE_KEY=""
# Finik's public key, used to check that payment notifications really come from Finik
FINIK_PUBLIC_KEY=""
# Optional: "beta" for Finik's test environment, or a full FINIK_API_URL
FINIK_ENV=""
# Optional: public site address for payment return links (defaults to the request host)
SITE_URL=""
